APP_NAME="Favia Health"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Sarajevo
FRONTEND_URL=http://localhost:3000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=favia_health
DB_USERNAME=postgres
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
DEMO_USER_EMAIL=demo@favia.test

# In development, Vite proxies this path to Laravel.
VITE_API_BASE_URL=/api

# Optional shared demo accounts. Keep disabled for private production use.
DEMO_LOGIN_ENABLED=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
